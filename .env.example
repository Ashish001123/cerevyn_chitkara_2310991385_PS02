# Copy to .env and `set -a; source .env; set +a` before starting the server.

# auto = Azure AI Speech when key+region are set, otherwise local engines; or force "azure" / "local"
SPEECH_PROVIDER=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_STT_LANGUAGE=en-IN
AZURE_TTS_VOICE=en-IN-NeerjaNeural

# Local engines
WHISPER_MODEL=small.en
LOCAL_TTS_VOICE=Samantha

# Storage
DB_PATH=data/appointments.db
AUDIO_OUT_DIR=data/tts_out

# Fixed clock so the seeded 20-21 October 2026 slots stay in the future. Remove in production.
APP_NOW=2026-10-11T09:00:00+05:30
